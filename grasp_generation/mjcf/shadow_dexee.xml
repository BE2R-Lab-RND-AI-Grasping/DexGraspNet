    <map force="0.1" fogend="5" />
  </visual>
  <default>
    <!--main-->
    <default class="robot0:D_Vizual">
      <geom contype="0" conaffinity="0" group="1" material="robot0:MatViz" />
    </default>

    <!--joints-->
    <default class="robot0:asset_class">
      <joint limited="true" margin="0.01" armature="0.001" damping="0.1" frictionloss="0.001" />
      <geom friction="1 0.005 0.001" margin="0.0005" />
      <site rgba="0.4 0.9 0.4 1" />
      <general ctrllimited="true" forcelimited="true" />
    </default>

    <!--sites-->
    <default class="finger_collision_hard">
      <geom condim="4" friction="1 0.001 2e-05" solref="-7000 -167"/>
    </default>
    <default class="finger_collision_soft">
      <geom condim="6" friction="1 0.005 0.0001" solref="-2500 -100"/>
    </default>
  </default>

