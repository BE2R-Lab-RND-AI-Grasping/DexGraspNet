<mujoco model="allegro_right">
  <!-- <compiler angle="radian" meshdir="assets"/> -->
  <compiler angle="radian" meshdir="./mjcf/assets/allegro"/>

  <option apirate="200" iterations="20"/>

  <default>
    <default class="allegro_right">
      <joint damping=".01"/>
      <position kp="1"/>
      <geom density="800"/>

      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" material="black"/>

      </default>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="0.5 0.5 0.5" width="265" height="256"/>
    
    <material name="black" rgba="0.2 0.2 0.2 0.5"/>
    <material name="white" rgba="0.9 0.9 0.9 0.5"/>

    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="link_0.0" file="link_0.0.stl"/>
    <mesh name="link_1.0" file="link_1.0.stl"/>
    <mesh name="link_2.0" file="link_2.0.stl"/>
    <mesh name="link_3.0" file="link_3.0.stl"/>
    <mesh name="link_3.0_tip" file="link_3.0_tip.stl"/>
    <mesh name="link_12.0_right" file="link_12.0_right.stl"/>
    <mesh name="link_13.0" file="link_13.0.stl"/>
    <mesh name="link_14.0" file="link_14.0.stl"/>
    <mesh name="link_15.0" file="link_15.0.stl"/>
    <mesh name="link_15.0_tip" file="link_15.0_tip.stl"/>
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />

    <!-- PALM -->
    <body name="palm" pos="0 0 0" quat="0 1 0 1" childclass="allegro_right">
      <!-- <inertial mass="0.4154" pos="0 0 0.0475" diaginertia="1e-4 1e-4 1e-4"/> -->
      <geom class="visual" type="mesh" mesh="base_link"/>
      
      <!-- First finger -->
      <body name="ff_base" pos="0 0.0435 -0.001542" quat="0.999048 -0.0436194 0 0">
        <joint name="ffj0" axis="0 0 1" range="-0.47 0.47"/>
        <geom class="visual" type="mesh" mesh="link_0.0"/>
        
        <body name="ff_proximal" pos="0 0 0.0164">
          <joint name="ffj1" axis="0 1 0" range="-0.196 1.61"/>
          <geom class="visual" type="mesh" mesh="link_1.0"/>

          <body name="ff_medial" pos="0 0 0.054">
            <joint name="ffj2" axis="0 1 0" range="-0.174 1.709"/>
            <geom class="visual" type="mesh" mesh="link_2.0"/>
            
            <body name="ff_distal" pos="0 0 0.0384">
              <joint name="ffj3" axis="0 1 0" range="-0.227 1.618"/>
              <geom class="visual" type="mesh" mesh="link_3.0"/>
              
              <body name="ff_tip" pos="0 0 0.0267">
                <geom class="visual" type="mesh" mesh="link_3.0_tip" material="white"/>

              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Middle finger -->
      <body name="mf_base" pos="0 0 0.0007">
        <joint name="mfj0" axis="0 0 1" range="-0.47 0.47"/>
        <geom class="visual" type="mesh" mesh="link_0.0"/>
        
        <body name="mf_proximal" pos="0 0 0.0164">
          <joint name="mfj1" axis="0 1 0" range="-0.196 1.61"/>
          <geom class="visual" type="mesh" mesh="link_1.0" />
          
          <body name="mf_medial" pos="0 0 0.054">
            <joint name="mfj2" axis="0 1 0" range="-0.174 1.709"/>
            <geom class="visual" type="mesh" mesh="link_2.0" />
            
            <body name="mf_distal" pos="0 0 0.0384">
              <joint name="mfj3" axis="0 1 0" range="-0.227 1.618"/>
              <geom class="visual" type="mesh" mesh="link_3.0" />
             
              <body name="mf_tip" pos="0 0 0.0267">
                <geom type="mesh" mesh="link_3.0_tip" material="white"/>
              </body>
            </body>
          </body>
        </body>
      </body>
      
      <!-- Ring finger -->
      <body name="rf_base" pos="0 -0.0435 -0.001542" quat="0.999048 0.0436194 0 0" >
        <joint name="rfj0" axis="0 0 1" range="-0.47 0.47"/>
        <geom class="visual" type="mesh" mesh="link_0.0"/>
        
        <body name="rf_proximal" pos="0 0 0.0164">
          <joint name="rfj1" axis="0 1 0" range="-0.196 1.61"/>
          <geom class="visual" type="mesh" mesh="link_1.0"/>
          
          <body name="rf_medial" pos="0 0 0.054">
            <joint name="rfj2" axis="0 1 0" range="-0.174 1.709"/>
            <geom class="visual" type="mesh" mesh="link_2.0"/>
            
            <body name="rf_distal" pos="0 0 0.0384">
              <joint name="rfj3" axis="0 1 0" range="-0.227 1.618"/>
              <geom class="visual" type="mesh" mesh="link_3.0"/>
              
              <body name="rf_tip" pos="0 0 0.0267">
                <geom type="mesh" mesh="link_3.0_tip" material="white"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Thumb -->
      <body name="th_base" pos="-0.0182 0.019333 -0.045987" quat="0.477714 -0.521334 -0.521334 -0.477714">
        <joint name="thj0" axis="-1 0 0" range="0.263 1.396"/>
        <geom class="visual" type="mesh" mesh="link_12.0_right"/>
        

        <body name="th_proximal" pos="-0.027 0.005 0.0399">
          <joint name="thj1" axis="0 0 1" range="-0.105 1.163"/>
          <geom class="visual" type="mesh" mesh="link_13.0"/>

          <body name="th_medial" pos="0 0 0.0177">
            <joint name="thj2" axis="0 1 0" range="-0.189 1.644"/>
            <geom class="visual" type="mesh" mesh="link_14.0"/>

            <body name="th_distal" pos="0 0 0.0514">
              <joint name="thj3" axis="0 1 0" range="-0.162 1.719"/>
              <geom class="visual" type="mesh" mesh="link_15.0"/>

              <body name="th_tip" pos="0 0 0.0423" >
                <geom type="mesh" mesh="link_15.0_tip" material="white"/>
              </body>
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>


  <actuator>
    <position name="ffa0" joint="ffj0" ctrlrange="-0.47 0.47"/>
    <position name="ffa1" joint="ffj1" ctrlrange="-0.196 1.61"/>
    <position name="ffa2" joint="ffj2" ctrlrange="-0.174 1.709"/>
    <position name="ffa3" joint="ffj3" ctrlrange="-0.227 1.618"/>
    <position name="mfa0" joint="mfj0" ctrlrange="-0.47 0.47"/>
    <position name="mfa1" joint="mfj1" ctrlrange="-0.196 1.61"/>
    <position name="mfa2" joint="mfj2" ctrlrange="-0.174 1.709"/>
    <position name="mfa3" joint="mfj3" ctrlrange="-0.227 1.618"/>
    <position name="rfa0" joint="rfj0" ctrlrange="-0.47 0.47"/>
    <position name="rfa1" joint="rfj1" ctrlrange="-0.196 1.61"/>
    <position name="rfa2" joint="rfj2" ctrlrange="-0.174 1.709"/>
    <position name="rfa3" joint="rfj3" ctrlrange="-0.227 1.618"/>
    <position name="tha0" joint="thj0" ctrlrange="0.263 1.396"/>
    <position name="tha1" joint="thj1" ctrlrange="-0.105 1.163"/>
    <position name="tha2" joint="thj2" ctrlrange="-0.189 1.644"/>
    <position name="tha3" joint="thj3" ctrlrange="-0.162 1.719"/>
  </actuator>
</mujoco>
