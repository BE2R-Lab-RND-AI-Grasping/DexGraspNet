    <mesh name="Link_thumb_abduction" file="Link_thumb_abduction.stl" />
    <mesh name="Link_thumb_PPflexion" file="Link_thumb_PPflexion.stl" />
    <mesh name="Link_thumb_DPflexion" file="Link_thumb_DPflexion.stl" />
