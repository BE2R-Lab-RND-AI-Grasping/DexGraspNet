<mujoco model="DIP-Flex_open_chain">
  <compiler angle="radian" meshdir="assets"/>

  <option apirate="200" iterations="20"/>

  <default>
    <!-- main -->
    <default class="vizual">
      <geom contype="1" conaffinity="1" group="1" material="MatViz"/>
    </default>

    <!-- joints -->
    <default class="asset_class">
      <joint limited="true" margin="0.01" armature="0.001" damping="0.1" frictionloss="0.001"/>
      <geom friction="1 0.05 0.001" margin="0.0005"/>
      <site rgba="1 0 0 1" />
      <general ctrllimited="true" forcelimited="true" />
    </default>

    <!-- sites -->
    <default class="finger_collision_hard">
      <geom condim="4" friction="1 0.001 2e-05" solref="-7000 -167"/>
    </default>
    <default class="finger_collision_soft">
      <geom condim="6" friction="1 0.005 0.0001" solref="-2500 -100"/>
    </default>
  </default>


  <asset>
    <material name="MatViz" specular="0.75" shininess="0.1" reflectance="0.5" rgba="0.3 0.3 0.3 1" />

    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="265" height="256"/>
    <mesh name="base_link" file="base_link.stl" />
    <mesh name="Link_pinkie_abduction" file="Link_pinkie_abduction.stl" />
    <mesh name="Link_pinkie_PPflexion" file="Link_pinkie_PPflexion.stl" />
