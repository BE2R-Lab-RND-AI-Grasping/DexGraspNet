	</asset>

<extension>
    <plugin plugin="mujoco.pid">
      <instance name="actuator_J0">
        <config key="kp" value="100"/>
        <config key="ki" value="100"/>
        <config key="kd" value="1e-10"/>
        <config key="imax" value="100"/>
        <config key="slewmax" value="3.14159"/>
      </instance>
    </plugin>
    <plugin plugin="mujoco.pid">
      <instance name="actuator_J1">
        <config key="kp" value="100"/>
        <config key="ki" value="1000"/>
        <config key="kd" value="1e-10"/>
        <config key="imax" value="100"/>
        <config key="slewmax" value="3.14159"/>
      </instance>
    </plugin>
    <plugin plugin="mujoco.pid">
      <instance name="actuator_J2">
        <config key="kp" value="100"/>
        <config key="ki" value="1000"/>
        <config key="kd" value="1e-10"/>
        <config key="imax" value="100"/>
        <config key="slewmax" value="3.14159"/>
      </instance>
    </plugin>
  </extension>

	<default>
