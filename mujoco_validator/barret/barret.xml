			<geom contype="1" conaffinity="1" group="1" rgba="0.5 0.6 0.7 1"/>			
		</default>
		<default class="wam_bhandViz">
			<geom contype="1" conaffinity="1" group="1" rgba="0.7 0.8 0.8 1"/>
		</default>
	</default>

