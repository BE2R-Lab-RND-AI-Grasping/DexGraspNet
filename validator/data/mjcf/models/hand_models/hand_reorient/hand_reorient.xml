<mujoco model="hand_asembly_ver2_URDF_5">
  <compiler angle="radian" meshdir="assets"/>
  
  <option iterations="20"/>
  <option cone="elliptic" noslip_iterations="5" noslip_tolerance="0">
    	<flag filterparent="enable"/>
  </option>
  
  <default>
    <joint damping=".5"/>
    <position kp="1"/>
    <geom density="800" rgba="0.7 0.7 0.7 1"/> 

    <default class="collision">
      <geom contype="0" conaffinity="1" group="0"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="0.5 0.5 0.5" width="265" height="256"/>

    <mesh name="base_link" file="base_link.stl"/>
    <mesh name="proximal_thumb" file="proximal_thumb.stl"/>
    <mesh name="mideal_thumb" file="mideal_thumb.stl"/>
    <mesh name="distal_thumb" file="distal_thumb.stl"/>
    <mesh name="proximal_finger_first" file="proximal_finger_first.stl"/>
    <mesh name="mideal_finger_first" file="mideal_finger_first.stl"/>
    <mesh name="distal_finger_first" file="distal_finger_first.stl"/>
    <mesh name="proximal_finger_second" file="proximal_finger_second.stl"/>
    <mesh name="mideal_finger_second" file="mideal_finger_second.stl"/>
    <mesh name="distal_finger_second" file="distal_finger_second.stl"/>
  </asset>

  <extension>
    <plugin plugin="mujoco.pid">
      <instance name="actuator_J0">
        <config key="kp" value="2.8"/>
        <config key="ki" value="4.0"/>
        <config key="kd" value="0.03"/>
        <config key="imax" value="0.1"/>
        <config key="slewmax" value="3.14159"/>
      </instance>
    </plugin>
    <plugin plugin="mujoco.pid">
      <instance name="actuator_J1">
        <config key="kp" value="2.5"/>
        <config key="ki" value="3.0"/>
        <config key="kd" value="0.02"/>
        <config key="imax" value="0.2"/>
        <config key="slewmax" value="3.14159"/>
      </instance>
    </plugin>
    <plugin plugin="mujoco.pid">
      <instance name="actuator_J2">
        <config key="kp" value="1.1"/>
        <config key="ki" value="3.0"/>
        <config key="kd" value="0.01"/>
        <config key="imax" value="0.2"/>
        <config key="slewmax" value="3.14159"/>
      </instance>
    </plugin>
    <!-- <plugin plugin="mujoco.pid">
      <instance name="actuator_J3">
        <config key="kp" value="0.6"/>
        <config key="ki" value="3.0"/>
        <config key="kd" value="0.008"/>
        <config key="imax" value="0.1"/>
        <config key="slewmax" value="3.14159"/>
      </instance>
    </plugin> -->
  </extension>

  <worldbody>
    <light directional="true" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1" pos="0 0 5.0" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1" />

    <!-- PALM -->
    <body name="palm" pos="0 0 0" childclass="collision">
      <joint name="base" type="free"/>
      <geom type="mesh" mesh="base_link" />
      <geom pos="-0.0302 0.04346 0.025" quat="1 0 0 0" type="mesh" mesh="proximal_finger_first"/>
      <geom pos="0.0196 0.04346 0.025" quat="1 0 0 0" type="mesh" mesh="proximal_finger_second"/>
      <!-- <geom class="colision_A" pos="-0.023 0.0 0.03" size="0.065 0.04 0.028"/> -->

      <!-- THUMB -->
      <body name="proximal_thumb" pos="-0.05532 -0.00754 0.0075">
        <inertial pos="-0.015654 0.029955 0.02991" quat="0.664062 0.66104 0.252428 0.241512" mass="0.1524" diaginertia="5.00908e-05 4.26441e-05 3.43441e-05"/>
        <joint name="joint_proximal_thumb" pos="0 0 0" axis="0 0 -1" range="-3.14 0"/>
        <geom type="mesh" mesh="proximal_thumb"/>
      
        <body name="mideal_thumb" pos="-0.024495 0.05232 0.05561">
          <inertial pos="0.00038305 -0.0013227 0.042746" quat="0.692641 0.0241494 -0.0128903 0.720763" mass="0.080951" diaginertia="2.93704e-05 2.29283e-05 1.49522e-05"/>
          <joint name="joint_mideal_thumb" pos="0 0 0" axis="1 0 0" range="-1.0 1.0"/>
          <geom type="mesh" mesh="mideal_thumb"/>
          <!-- <geom class="colision_A" pos="0 -0.005 0.045" size="0.02 0.015 0.025"/> -->
          
          <body name="distal_thumb" pos="0 0 0.05861">
            <inertial pos="0.00023967 -0.00041638 0.034377" quat="0.707098 0.00326804 -0.00326966 0.7071" mass="0.025098" diaginertia="1.61256e-05 1.1258e-05 9.064e-06"/>
            <joint name="joint_distal_thumb" pos="0 0 0" axis="1 0 0" range="-1.57 1.57"/>
            <geom type="mesh" mesh="distal_thumb"/>
            <!-- <geom class="colision_A" pos="0 -0.005 0.045" size="0.02 0.015 0.02"/> -->
          
          </body>
        
        </body>
      </body>

      <!-- FINGER FIRST -->
      <body name="mideal_finger_first" pos="-0.029825 0.04486 0.06311">
        <inertial pos="0.00038305 -0.00132274 0.0427465" quat="0.692641 0.0241503 -0.0128906 0.720763" mass="0.0809511" diaginertia="2.93701e-05 2.2928e-05 1.49524e-05"/>
        <joint name="joint_mideal_finger_first" pos="0 0 0" axis="1 0 0" range="-1.0 1.0"/>
        <geom type="mesh" mesh="mideal_finger_first"/>
        <!-- <geom class="colision_A" pos="0 -0.005 0.045" size="0.02 0.015 0.025"/> -->
        
        <body name="distal_finger_first" pos="0 0 0.05861">
          <inertial pos="0.000239668 -0.000416381 0.0343767" quat="0.707098 0.00326816 -0.00326978 0.7071" mass="0.0250979" diaginertia="1.61254e-05 1.12577e-05 9.06401e-06"/>
          <joint name="joint_distal_finger_first" pos="0 0 0" axis="1 0 0" range="-1.57 1.57"/>
          <geom type="mesh" mesh="distal_finger_first"/>
          <!-- <geom class="colision_A" pos="0 -0.005 0.045" size="0.02 0.015 0.02"/> -->
        
        </body>
        
      </body>

      <!-- FINGER SECOND -->
      <body name="mideal_finger_second" pos="0.019975 0.04486 0.06311">
        <inertial pos="0.00038305 -0.00132274 0.0427465" quat="0.692641 0.0241503 -0.0128906 0.720763" mass="0.0809511" diaginertia="2.93701e-05 2.2928e-05 1.49524e-05"/>
        <joint name="joint_mideal_finger_second" pos="0 0 0" axis="1 0 0" range="-1.0 1.0"/>
        <geom type="mesh" mesh="mideal_finger_second"/>
        <!-- <geom class="colision_A" pos="0 -0.005 0.045" size="0.02 0.015 0.025"/> -->
        
        <body name="distal_finger_second" pos="0 0 0.05861">
          <inertial pos="0.000239667 -0.000416382 0.0343767" quat="0.707098 0.0032682 -0.00326972 0.7071" mass="0.0250979" diaginertia="1.61254e-05 1.12577e-05 9.06401e-06"/>
          <joint name="joint_distal_finger_second" pos="0 0 0" axis="1 0 0" range="-1.57 1.57"/>
          <geom type="mesh" mesh="distal_finger_second"/>
          <!-- <geom class="colision_A" pos="0 -0.005 0.045" size="0.02 0.015 0.02"/> -->
        
        </body>

      </body>
    </body>
  </worldbody>

  <!-- <actuator>
    <position name="thumb_0" joint="joint_proximal_thumb" ctrlrange="-3.14 0"/>
    <position name="thumb_1" joint="joint_mideal_thumb" ctrlrange="-1.0 1.0"/>
    <position name="thumb_2" joint="joint_distal_thumb" ctrlrange="-1.57 1.57"/>

    <position name="f_finger_0" joint="joint_mideal_finger_first" ctrlrange="-1.0 1.0"/>
    <position name="f_finger_1" joint="joint_distal_finger_first" ctrlrange="-1.57 1.57"/>
    
    <position name="s_finger_0" joint="joint_mideal_finger_second" ctrlrange="-1.0 1.0"/>
    <position name="s_finger_1" joint="joint_distal_finger_second" ctrlrange="-1.57 1.57"/>
  </actuator> -->

  <actuator>
    <plugin name="proximal_thumb_actuator" plugin="mujoco.pid" instance="actuator_J0" ctrlrange="-3.14 0"
      forcerange="-9 5.3" dyntype="none" joint="joint_proximal_thumb" actdim="2"/>
    <plugin name="mideal_thumb_actuator" plugin="mujoco.pid" instance="actuator_J1" ctrlrange="-1.0 1.0"
      forcerange="-9 5.3" dyntype="none" joint="joint_mideal_thumb" actdim="2"/>
    <plugin name="distal_thumb_actuator" plugin="mujoco.pid" instance="actuator_J2" ctrlrange="-1.57 1.57"
      forcerange="-9 5.3" dyntype="none" joint="joint_distal_thumb" actdim="2"/> 

    <plugin name="mideal_finger_first_actuator" plugin="mujoco.pid" instance="actuator_J1" ctrlrange="-1.0 1.0"
      forcerange="-9 5.3" dyntype="none" joint="joint_mideal_finger_first" actdim="2"/>
    <plugin name="distal_finger_first_actuator" plugin="mujoco.pid" instance="actuator_J2" ctrlrange="-1.57 1.57"
      forcerange="-9 5.3" dyntype="none" joint="joint_distal_finger_first" actdim="2"/> 

    <plugin name="mideal_finger_second_actuator" plugin="mujoco.pid" instance="actuator_J1" ctrlrange="-1.0 1.0"
      forcerange="-9 5.3" dyntype="none" joint="joint_mideal_finger_second" actdim="2"/>
    <plugin name="distal_finger_second_actuator" plugin="mujoco.pid" instance="actuator_J2" ctrlrange="-1.57 1.57"
      forcerange="-9 5.3" dyntype="none" joint="joint_distal_finger_second" actdim="2"/> 
    
  </actuator>

</mujoco>
